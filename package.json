{
  "name": "antoniszisis-website",
  "version": "0.4.1",
  "type": "module",
  "private": true,
  "author": "Antonis Zisis",
  "description": "Antonis Zisis' personal website.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "react-router dev --port 3000",
    "build": "react-router build",
    "preview": "react-router-serve build/server/index.js",
    "lint": "eslint 'app/**/*.{js,jsx,ts,tsx}' --quiet",
    "lint:fix": "eslint 'app/**/*.{js,jsx,ts,tsx}' --fix",
    "format": "prettier --write 'app/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'app/**/*.{ts,tsx}'",
    "typecheck": "react-router typegen && tsc",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-router/node": "^7.13.0",
    "@react-router/serve": "^7.13.0",
    "classnames": "^2.5.1",
    "framer-motion": "^12.5.0",
    "isbot": "^5.1.23",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@eslint/js": "^9.39.3",
    "@netlify/vite-plugin": "^2.10.2",
    "@netlify/vite-plugin-react-router": "^2.1.3",
    "@react-router/dev": "^7.13.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.12.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^9.39.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.28.2"
