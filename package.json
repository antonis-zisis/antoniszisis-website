{
  "name": "antoniszisis-website",
  "version": "0.5.2",
  "type": "module",
  "private": true,
  "author": "Antonis Zisis",
  "description": "Antonis Zisis' personal website.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "react-router dev --port 3000",
    "build": "react-router build",
    "preview": "react-router-serve build/server/index.js",
    "lint": "eslint 'src/**/*.{js,jsx,ts,tsx}' --quiet",
    "lint:fix": "eslint 'src/**/*.{js,jsx,ts,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}'",
    "typecheck": "react-router typegen && tsc",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-router/node": "^8.1.0",
    "@react-router/serve": "^8.1.0",
    "classnames": "^2.5.1",
    "framer-motion": "^12.5.0",
    "isbot": "^5.1.23",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@netlify/vite-plugin": "^2.12.8",
    "@netlify/vite-plugin-react-router": "^4.0.0",
    "@react-router/dev": "^8.1.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^10.6.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.3",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.28.2"
}
